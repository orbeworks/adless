{
  "name": "adless",
  "private": true,
  "version": "0.1.0",
  "description": "Adless iOS app and landing page monorepo",
  "workspaces": [
    "apps/landing-page"
  ],
  "scripts": {
    "dev:landing": "npm --workspace @adless/landing-page run dev",
    "build": "npm run build:landing",
    "build:landing": "npm --workspace @adless/landing-page run build",
    "lint": "npm --workspace @adless/landing-page run lint",
    "typecheck": "npm --workspace @adless/landing-page run typecheck",
    "build:dns-worker": "npm --prefix apps/dns-worker run build",
    "test:dns-worker": "npm --prefix apps/dns-worker run test",
    "prepare:dns-blocklist": "python3 tools/dns-worker/prepare_blocklist.py",
    "preview:landing": "npm --workspace @adless/landing-page run preview",
    "prepare": "bash tools/dev/install-git-hooks.sh",
    "setup:hooks": "bash tools/dev/install-git-hooks.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@configcat/sdk": "^1.1.0",
    "@peculiar/x509": "^2.1.0",
    "jose": "^6.2.11",
    "reflect-metadata": "^0.2.2"
  }
}
