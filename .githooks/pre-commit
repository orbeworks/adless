#!/usr/bin/env bash

set -euo pipefail

# shellcheck disable=SC1091
source "$(dirname "$0")/common.sh"

staged_paths_file="$(mktemp "${TMPDIR:-/tmp}/adless-pre-commit.XXXXXX")"
trap 'rm -f "$staged_paths_file"' EXIT

git diff --cached --check
git diff --cached --name-only --diff-filter=ACMR > "$staged_paths_file"

if has_path_matching "$staged_paths_file" "tools/blocklists/*.py" "tools/blocklists/**/*.py" "tools/appstore/*.py" "tools/appstore/**/*.py" "tools/dns-worker/*.py" "tools/dns-worker/**/*.py"; then
  run_python_syntax "$staged_paths_file"
fi

if has_path_matching "$staged_paths_file" "apps/landing-page/**" "package.json" "package-lock.json"; then
  run_landing_lint
fi

echo "Adless pre-commit checks passed."
